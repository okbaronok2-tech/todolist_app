# 원칙 6.1 환경변수. 복사해 .env(개발)·.env.test(테스트)로 쓴다. 두 파일은 커밋하지 않는다.
# 로드: node --env-file=.env (dotenv 미사용)

# pg Pool 연결 문자열. 개발은 todolist, 테스트(.env.test)는 todolist_test
# 운영에서 DB가 다른 호스트면 `?sslmode=require`를 붙인다 (11-security S-06). 로컬은 불필요
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todolist

# 액세스 토큰 HS384 서명 키. 48자 이상(384비트). 기본값 없음, 없거나 짧으면 로컬 server.js는 기동 실패 (NFR-06, Vercel은 기동 검사 없음)
JWT_SECRET=

# Express 포트. 기본 3000
PORT=3000

# production이면 인증 쿠키에 Secure 설정 (NFR-06). 그 외는 로컬 HTTP 허용
NODE_ENV=development

# CORS 허용 origin (NFR-06 (6)). SPA origin을 쉼표로 나열. 개발은 Vite 기본 포트. 없으면 로컬 server.js는 기동 실패 (Vercel은 검사 없음)
# 쿠키 SameSite는 개발 Lax, 운영(NODE_ENV=production) None+Secure라 운영은 SPA와 API가 다른 site여도 된다
CORS_ORIGIN=http://localhost:5173
