# 원칙 6.1 환경변수. 복사해 .env(개발)·.env.test(테스트)로 쓴다. 두 파일은 커밋하지 않는다.
# 로드: node --env-file=.env (dotenv 미사용)

# pg Pool 연결 문자열. 개발은 todolist, 테스트(.env.test)는 todolist_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todolist

# 액세스 토큰 HS384 서명 키. 48자 이상(384비트). 기본값 없음, 없거나 짧으면 기동 실패 (NFR-06)
JWT_SECRET=

# Express 포트. 기본 3000
PORT=3000

# production이면 인증 쿠키에 Secure 설정 (NFR-06). 그 외는 로컬 HTTP 허용
NODE_ENV=development
